NODE_ENV=development
PORT=5000
MONGODB_URI=
SESSION_SECRET=
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/college_portal
# Signs the login cookie. Use 32+ random characters (required in production). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
# Used to hash Aadhaar numbers for sign-in; use a long random value and keep it private
LOGIN_ID_HASH_SECRET=
# Name of the login cookie
SESSION_NAME=icms.sid
# Idle time before a user is logged out, in milliseconds (1800000 = 30 minutes)
SESSION_MAX_AGE_MS=1800000
UPLOAD_DIR=uploads
# Optional: shared password for demo users created by `npm run seed` (12+ characters)
DEMO_PASSWORD=
# Payment gateway (test mode only)
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
# Secret key used to make private fingerprints of typed emails/mobile/Aadhaar numbers for the rate limiter.
# REQUIRED in production (32+ random characters). In development, if empty, one is derived from SESSION_SECRET.
# Use a different value from SESSION_SECRET and LOGIN_ID_HASH_SECRET. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it later only restarts the attempt counters; it does not affect passwords, users or sessions.
RATE_LIMIT_HASH_SECRET=
# Brute-force protection (all optional; these are the defaults)
# Failed sign-ins allowed per IP address in the window (15 minutes):
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_LOGIN_WINDOW_MS=900000
# "Forgot password" requests per IP and per email address, per hour:
RATE_LIMIT_FORGOT_IP_MAX=5
RATE_LIMIT_FORGOT_EMAIL_MAX=3
RATE_LIMIT_FORGOT_WINDOW_MS=3600000
# "Reset password" requests per IP, per hour:
RATE_LIMIT_RESET_MAX=10
RATE_LIMIT_RESET_WINDOW_MS=3600000
# Wrong passwords in a row before an account is locked, and for how long (15 minutes):
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MS=900000
# Email (password reset links). Leave SMTP_HOST empty in development: the reset link is then printed in the
# server console instead of being emailed. In production real SMTP settings are required.
# Razorpay (use TEST mode keys: Dashboard > Test Mode > Settings > API Keys). Key id starts with rzp_test_
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you type when you add the webhook in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=
# Email
SMTP_HOST=
SMTP_PORT=587
# true only for port 465; use false for port 587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Shown as the sender, e.g. EROMZA College Portal <no-reply@yourcollege.edu>
EMAIL_FROM=
