NODE_ENV=development
PORT=5000

# MongoDB connection string, e.g. mongodb://127.0.0.1:27017/college_portal
MONGODB_URI=mongodb://127.0.0.1:27017/college_portal

CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads

# Signs the login cookie. Use 32+ random characters (required in production). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string
# Name of the login cookie
SESSION_NAME=icms.sid
# Idle time before a user is logged out, in milliseconds (1800000 = 30 minutes)
SESSION_MAX_AGE_MS=1800000

# Hashes Aadhaar login ids. Required outside tests, at least 16 characters. Use a long random value;
# changing it breaks Aadhaar sign-in. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
LOGIN_ID_HASH_SECRET=

# Secret key used to make private fingerprints of typed emails/mobile/Aadhaar numbers for the rate limiter.
# REQUIRED in production (32+ random characters). In development, if empty, one is derived from SESSION_SECRET.
# Use a different value from SESSION_SECRET and LOGIN_ID_HASH_SECRET. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it later only restarts the attempt counters; it does not affect passwords, users or sessions.
RATE_LIMIT_HASH_SECRET=

# Encrypts full Aadhaar, mobile, date of birth and parent mobile values on admission applications (AES-256-GCM).
# REQUIRED outside tests. Must be exactly 32 random bytes encoded as standard base64. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Store it outside MongoDB and keep a backup: changing it makes existing encrypted values unreadable.
FIELD_ENCRYPTION_KEY=
# Short label stored with each ciphertext so keys can be rotated without downtime. Defaults to v1.
FIELD_ENCRYPTION_KEY_ID=v1
# JSON map of retired key IDs to their base64 keys, e.g. {"v1":"<old-32-byte-key>"}.
# Required only while old ciphertext remains after a rotation. Values are never printed in logs.
FIELD_ENCRYPTION_PREVIOUS_KEYS={}

# Brute-force protection (all optional; these are the defaults)
# Failed sign-ins allowed per IP address in the window (15 minutes):
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_LOGIN_WINDOW_MS=900000
# "Forgot password" requests per IP and per email address, per hour:
RATE_LIMIT_FORGOT_IP_MAX=5
RATE_LIMIT_FORGOT_EMAIL_MAX=3
RATE_LIMIT_FORGOT_WINDOW_MS=3600000
# "Reset password" requests per IP, per hour:
RATE_LIMIT_RESET_MAX=10
RATE_LIMIT_RESET_WINDOW_MS=3600000
# Wrong passwords in a row before an account is locked, and for how long (15 minutes):
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MS=900000

# Payment gateway. Required outside tests. Valid values: fake, razorpay.
# "fake" is allowed only in development/test. Production requires "razorpay".
# Razorpay requires test-mode keys (rzp_test_...); live keys are rejected. Production validates all
# payment settings at startup and exits before serving requests if they are missing or invalid.
PAYMENT_GATEWAY=fake
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Background jobs. Disable with JOBS_ENABLED=false; set JOBS_RUN_ON_START=true to run once at boot.
# Intervals are in milliseconds (86400000 = 1 day, 900000 = 15 minutes).
# PAYMENT_RECONCILIATION_* must be positive whole numbers; malformed values stop startup outside tests.
JOBS_ENABLED=true
JOBS_RUN_ON_START=false
ADMISSION_DEADLINE_INTERVAL_MS=86400000
PAYMENT_RECONCILIATION_INTERVAL_MS=900000
# Ignore very new orders; give the browser/webhook time to settle them first (1800000 = 30 minutes).
PAYMENT_RECONCILIATION_MIN_AGE_MS=1800000
JOB_BATCH_SIZE=100

# Optional: shared password for demo users created by `npm run seed` (12+ characters)
DEMO_PASSWORD=

# Email (password reset links). Leave SMTP_HOST empty in development: the reset link is then printed in the
# server console instead of being emailed. In production real SMTP settings are required.
SMTP_HOST=
SMTP_PORT=587
# true only for port 465; use false for port 587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Shown as the sender, e.g. EROMZA College Portal <no-reply@yourcollege.edu>
EMAIL_FROM=
