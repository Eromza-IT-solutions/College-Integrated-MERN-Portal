NODE_ENV=development
PORT=5000
MONGODB_URI=
SESSION_SECRET=
# Hashes Aadhaar login ids. Use a long random value; changing it breaks Aadhaar sign-in.
LOGIN_ID_HASH_SECRET=
CLIENT_ORIGIN=http://localhost:5173
# Payments: use "fake" for offline demos, or "razorpay" with TEST mode keys.
# Razorpay Dashboard > Test Mode > Settings > API Keys. Key id starts with rzp_test_
PAYMENT_GATEWAY=fake
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
# The secret you type when you add the webhook in the Razorpay dashboard
PAYMENT_WEBHOOK_SECRET=
# Email
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
