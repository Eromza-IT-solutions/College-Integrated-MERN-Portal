{
  "name": "college-portal-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "lint": "eslint .",
    "openapi:check": "node scripts/validate-openapi.js",
    "seed": "node scripts/seed-demo-data.js",
    "seed:programs": "node scripts/seed-college-programs.js",
    "seed:fees": "node scripts/seed-college-fees.js",
    "seed:subjects": "node scripts/seed-college-subjects.js",
    "seed:sample-subjects": "node scripts/seed-sample-subjects.js",
    "seed:exam": "node scripts/seed-sample-exam.js",
    "seed:timetable": "node scripts/seed-sample-timetable.js",
    "seed:permissions": "node scripts/seed-permissions.js",
    "job:admission-deadlines": "node scripts/run-admission-deadlines.js",
    "job:payment-reconciliation": "node scripts/run-payment-reconciliation.js",
    "migrate:data-integrity": "node scripts/migrate-data-integrity.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "seed:demo-student": "node scripts/seed-demo-student.js",
    "seed:demo-applicant": "node scripts/seed-demo-applicant.js",
    "seed:website-content": "node scripts/seed-website-content.js",
    "seed:audit-logs": "node scripts/seed-sample-audit-logs.js",
    "create-super-admin": "node scripts/create-super-admin.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-mongo": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "morgan": "^1.12.1",
    "multer": "^2.0.1",
    "nodemailer": "^10.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "js-yaml": "^4.1.0",
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "allowScripts": {
    "mongodb-memory-server@10.4.3": true
  }
}
